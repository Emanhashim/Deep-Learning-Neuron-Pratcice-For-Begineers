import torch
scalar = torch.tensor(10)

vector = torch.tensor([2, 4, 6, 8])

matrix = torch.tensor([
    [1, 2, 3], 
    [4, 5, 6] ])

tensor_3d = torch.tensor([
    [[1, 2], [3, 4]],
    [[5, 6], [7, 8]]
])

print("Scalar:", scalar)
print("Vector:", vector)    
print("Matrix:", matrix)
print("3D Tensor:", tensor_3d)
print("Scalar shape:", scalar.shape)
print("Vector shape:", vector.shape)
print("Matrix shape:", matrix.shape)